# Axon - Example Environment Variables
# Copy this file to .env (working directory) or ~/.axon/.env and uncomment what you need.
# Full list: docs/REFERENCE.md section 4. Everything here is optional.

# --- LLM providers (set the key for the provider you use) ---
# OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# OLLAMA_CLOUD_URL=
# OLLAMA_CLOUD_KEY=
# VLLM_BASE_URL=
# AXON_LOCAL_LLM_BASE_URL=http://localhost:8080
# LOCAL_LLM_API_KEY=
# GITHUB_COPILOT_PAT=
# BRAVE_API_KEY=

# --- Store ---
# AXON_STORE_BASE=~/.axon
# AXON_CONFIG_PATH=./config.yaml

# --- axon-api server ---
# Bind to localhost by default. For containerized runs (Docker/Compose/K8s), set AXON_HOST=0.0.0.0
# so the API is reachable from the host. Use 0.0.0.0 only for authenticated deployments behind network controls.
# AXON_HOST=127.0.0.1
# AXON_PORT=8420
# RAG_API_KEY=
# RAG_INGEST_BASE=

# --- Client (axon CLI/REPL, axon-mcp) ---
# AXON_API_BASE=http://localhost:8420
# RAG_API_BASE=http://localhost:8420

# --- Misc ---
# AXON_DEBUG=1
# PYTHONUTF8=1
